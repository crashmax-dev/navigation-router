{
  "name": "navigation-router",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "description": "Client-side router built on the Navigation API and URLPattern",
  "author": "crashmax",
  "license": "MIT",
  "homepage": "https://github.com/crashmax-dev/navigation-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crashmax-dev/navigation-router.git"
  },
  "bugs": {
    "url": "https://github.com/crashmax-dev/navigation-router/issues"
  },
  "keywords": [
    "router",
    "navigation-api",
    "urlpattern",
    "spa",
    "client-router"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "pnpm typecheck && pnpm build:lib && pnpm build:playground",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/postbuild-lib.mjs",
    "build:playground": "vite build --config playground/vite.config.ts",
    "build:site": "bash scripts/build-site.sh",
    "preview": "vite preview --config playground/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "type-check": "tsc",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build:lib"
  },
  "peerDependencies": {
    "navigation-api-types": ">=0.6.0"
  },
  "peerDependenciesMeta": {
    "navigation-api-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "7.2.0",
    "@types/node": "22.19.9",
    "@zero-dependency/dom": "1.8.5",
    "eslint": "9.39.2",
    "jsdom": "26.1.0",
    "navigation-api-types": "0.6.1",
    "typescript": "6.0.3",
    "urlpattern-polyfill": "10.1.0",
    "vite": "8.1.5",
    "vitepress": "2.0.0-alpha.18",
    "vitest": "4.1.10"
  }
}
